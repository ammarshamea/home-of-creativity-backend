              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "X-N8N-Secret",
              "value": "={{ $('Normalize Event').item.json.callback_secret }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { event: 'REQUEST_SUBMITTED', request_number: $('Normalize Event').item.json.request_number, payload: { ai_analysis: $('Normalize Event').item.json.ai_analysis } } }}",
        "options": {
          "timeout": 12000
