{
  "name": "HOC Request Automation",
  "active": false,
  "nodes": [
    {
      "id": "webhook",
      "name": "Laravel Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "hoc-events",
      "parameters": {
        "httpMethod": "POST",
        "path": "hoc-events",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "normalize",
      "name": "Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nreturn [{ json: {\n  event: String(body.event || ''),\n  event_uuid: String(body.event_uuid || ''),\n  request_number: String(body.request_number || ''),\n  request_uuid: String(body.request_uuid || body.payload?.uuid || ''),\n  payload: body.payload || {},\n  api_url: String($env.HOC_API_URL || 'http://127.0.0.1:8000').replace(/\\/$/, ''),\n  secret: String($env.HOC_N8N_SECRET || 'change-me')\n}}];"
      }
    },
    {
      "id": "router",
      "name": "Event Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [640, 300],
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.event }}", "rightValue": "REQUEST_SUBMITTED", "operator": { "type": "string", "operation": "equals" } }] } },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.event }}", "rightValue": "PAYMENT_CONFIRMED", "operator": { "type": "string", "operation": "equals" } }] } },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.event }}", "rightValue": "REVISION_REQUESTED", "operator": { "type": "string", "operation": "equals" } }] } }
          ]
        }
      }
    },
    {
      "id": "sales-clickup",
      "name": "ClickUp Sales Intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 120],
      "parameters": {
        "method": "POST",
        "url": "https://api.clickup.com/api/v2/list/{{ $env.CLICKUP_LIST_ID }}/task",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "={{ $env.CLICKUP_TOKEN }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { name: `[Sales] ${$json.request_number} ${$json.payload.title || ''}`.trim(), description: $json.payload.description || '' } }}"
      }
    },
    {
      "id": "sales-map",
      "name": "Save Sales Mapping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 120],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_url }}/api/integrations/clickup/mapping",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "={{ $json.secret }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  request_number: $('Normalize Event').item.json.request_number,\n  event_uuid: $('Normalize Event').item.json.event_uuid,\n  request_uuid: $('Normalize Event').item.json.request_uuid,\n  task_type: 'sales',\n  integration_key: `${$('Normalize Event').item.json.request_uuid}:0:sales`,\n  clickup_task_id: String($json.id || $json.data?.id || 'CU-SALES'),\n  clickup_url: $json.url || null,\n  status: $json.status?.status || 'open'\n} }}"
      }
    },
    {
      "id": "exec-clickup",
      "name": "ClickUp Execution Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_url }}/api/integrations/clickup/tasks",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "={{ $json.secret }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  request_number: $json.request_number,\n  briefs: ($json.payload.briefs || []).map((brief) => ({\n    department: brief.type || brief.department,\n    brief: brief.brief || ''\n  }))\n} }}"
      }
    },
    {
      "id": "exec-map",
      "name": "Save Execution Mappings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "jsCode": "const root = $('Normalize Event').item.json;\nconst created = $input.first().json.data?.briefs || [];\nreturn created.map((brief, index) => ({\n  json: {\n    api_url: root.api_url,\n    secret: root.secret,\n    request_number: root.request_number,\n    event_uuid: root.event_uuid,\n    request_uuid: root.request_uuid,\n    brief_id: (root.payload.briefs?.[index]?.id) || null,\n    task_type: brief.department,\n    integration_key: `${root.request_uuid}:${(root.payload.briefs?.[index]?.id) || index + 1}:${brief.department}`,\n    clickup_task_id: brief.clickup_task_id,\n    clickup_url: brief.clickup_url || null\n  }\n}));"
      }
    },
    {
      "id": "exec-map-http",
      "name": "POST Execution Mapping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_url }}/api/integrations/clickup/mapping",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "={{ $json.secret }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      }
    },
    {
      "id": "revision-clickup",
      "name": "ClickUp Revision Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 480],
      "parameters": {
        "method": "POST",
        "url": "https://api.clickup.com/api/v2/list/{{ $env.CLICKUP_LIST_ID }}/task",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "={{ $env.CLICKUP_TOKEN }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { name: `[Revision] ${$json.request_number}`, description: $json.payload.reason || $json.payload.description || '' } }}"
      }
    },
    {
      "id": "revision-map",
      "name": "Save Revision Mapping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 480],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_url }}/api/integrations/clickup/mapping",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-N8N-Secret", "value": "={{ $json.secret }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  request_number: $('Normalize Event').item.json.request_number,\n  event_uuid: $('Normalize Event').item.json.event_uuid,\n  request_uuid: $('Normalize Event').item.json.request_uuid,\n  task_type: 'revision',\n  integration_key: `${$('Normalize Event').item.json.request_uuid}:0:revision`,\n  clickup_task_id: String($json.id || $json.data?.id || 'CU-REV'),\n  clickup_url: $json.url || null\n} }}"
      }
    }
  ],
  "connections": {
    "Laravel Event": { "main": [[{ "node": "Normalize Event", "type": "main", "index": 0 }]] },
    "Normalize Event": { "main": [[{ "node": "Event Router", "type": "main", "index": 0 }]] },
    "Event Router": {
      "main": [
        [{ "node": "ClickUp Sales Intake", "type": "main", "index": 0 }],
        [{ "node": "ClickUp Execution Tasks", "type": "main", "index": 0 }],
        [{ "node": "ClickUp Revision Task", "type": "main", "index": 0 }]
      ]
    },
    "ClickUp Sales Intake": { "main": [[{ "node": "Save Sales Mapping", "type": "main", "index": 0 }]] },
    "ClickUp Execution Tasks": { "main": [[{ "node": "Save Execution Mappings", "type": "main", "index": 0 }]] },
    "Save Execution Mappings": { "main": [[{ "node": "POST Execution Mapping", "type": "main", "index": 0 }]] },
    "ClickUp Revision Task": { "main": [[{ "node": "Save Revision Mapping", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
